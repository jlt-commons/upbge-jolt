{;; upbge-jolt embeds a jolt runtime (REPL + bridge) inside a UPBGE/Blender
 ;; host process. The host side is a small C shim (native/) exposing a flat C
 ;; ABI over RNA and the game engine; this project builds that runtime as a
 ;; --library shared object the host dlopens.
 ;;
 ;; nREPL streaming (out/err per flush) and :collect-safe exports need the
 ;; 0.8.13 floor; the nrepl middleware dep wants >= 0.8.24-era jolt.nrepl/start
 ;; with the :port-file opts.
 :jolt/min-version "0.8.13"

 :paths ["src"]

  :deps {jolt-lang/nrepl {:git/url "https://github.com/jolt-lang/nrepl"
                          :git/tag "v0.4.1" :git/sha "51c2572"}
         ;; ebb (missionary on jolt) is the concurrency foundation: the
         ;; bridge marshals RNA work onto the host tick thread through a
         ;; dataflow variable, and the engine layer (sensors/input/frame
         ;; events) rides ebb's flows. See src/upbge_jolt/core.clj.
         jlt-commons/ebb {:git/url "https://github.com/jlt-commons/ebb"
                          :git/sha "db4d72d12af7c961d40c70be924e03cfe2d6c959"}}

 ;; No :jolt/native: the bridge's ujs_* symbols resolve from the host
 ;; process (the real shim is compiled into the UPBGE binary). A declared
 ;; native would be searched first and shadow it. Tests load the mock shim
 ;; (native/libupbge_shim.dylib) explicitly, see test/upbge_jolt/mock_host.clj.

 :aliases {:test {:extra-paths ["test"]
                  :main-opts   ["-m" "upbge-jolt.test-runner"]}

           ;; code metrics (jlt-commons/jolt-metrics): jolt -M:metrics src
           :metrics {:extra-deps {jlt-commons/jolt-metrics
                                  {:git/url "https://github.com/jlt-commons/jolt-metrics"
                                   :git/sha "c23aec7f5071c60b6ba9be61dd93afa3583a375f"}}
                     :main-opts ["-m" "metrics.cli"]}}

 :tasks {:requires ([babashka.fs :as fs])
         :init (do (def os-name (System/getProperty "os.name"))
                   (def mac? (some? (re-find #"^Mac" os-name)))
                   (def shlib (str "native/libupbge_shim." (if mac? "dylib" "so")))
                   ;; GNUmakefile's OS/CPU names: lib/$(OS)_$(CPU) for the deps
                   ;; harvest (macos_arm64, linux_x64, ...), build_$(OS_NCASE)
                   ;; for the build tree (build_darwin, build_linux)
                   (def upbge-os (cond (re-find #"^Mac" os-name) "macos"
                                       (re-find #"^Linux" os-name) "linux"
                                       :else "windows"))
                   (def upbge-os-case (cond mac? "darwin"
                                            (re-find #"^Linux" os-name) "linux"
                                            :else "windows"))
                   (def upbge-cpu (case (System/getProperty "os.arch")
                                    "aarch64" "arm64"
                                    ("x86_64" "amd64") "x64"
                                    (System/getProperty "os.arch")))
                   (def upbge-src "native/upbge")
                   (def upbge-build (str "native/build_" upbge-os-case))
                   (def blender-bin (str upbge-build "/bin/"
                                         (if mac? "Blender.app/Contents/MacOS/Blender"
                                             "blender")))
                   ;; make deps harvests the prebuilt platform libs into the
                   ;; clone's lib/$(OS)_$(CPU) (before that the dir holds only
                   ;; deps.md from the repo), so any harvested lib marks deps done
                   (def deps-marker (str upbge-src "/lib/" upbge-os "_" upbge-cpu "/imath")))

         native
         {:doc "build the mock host shim dylib (for tests; the real shim needs a UPBGE build)"
          :task (if (or (not (fs/exists? shlib))
                        (seq (fs/modified-since shlib ["native/mock_shim.c" "native/upbge_shim.h" "deps.edn"])))
                  (do (shell "cc" "-O2" "-fPIC" "-shared" "-Inative"
                             "native/mock_shim.c" "-o" shlib)
                      (println "built:" shlib))
                  (println "up to date:" shlib))}

         test {:doc "unit tests (headless, mock shim)" :depends [native] :task (shell "jolt -M:test")}

         metrics
         {:doc "code-metrics report (jolt-metrics) over src, markdown to stdout"
          :task (shell "jolt" "-M:metrics" "src" "--config" ".jolt-metrics.edn")}

         upbge-deps
         {:doc "clone UPBGE into native/upbge and build its dependencies (skipped once harvested)"
          :task (if (fs/exists? deps-marker)
                  (println "upbge-deps: up to date -" deps-marker)
                  (do (when-not (fs/exists? upbge-src)
                        (shell "git" "clone" "https://github.com/UPBGE/upbge.git" upbge-src))
                      ;; CMake 4.x dropped <3.5 compat; most UPBGE externals
                      ;; (openal, x265, ...) still declare it. Env var rather
                      ;; than -D so it reaches the ExternalProject sub-configures.
                      (shell "env" "CMAKE_POLICY_VERSION_MINIMUM=3.5"
                             "make" "-C" upbge-src "-j"
                             (str (.availableProcessors (Runtime/getRuntime))) "deps")))}

         upbge
         {:doc "build the full UPBGE/Blender binary (deps first; skipped once built)"
          :depends [upbge-deps]
          :task (if (fs/exists? blender-bin)
                  (println "upbge: up to date -" blender-bin)
                  (shell "make" "-C" upbge-src "-j"
                         (str (.availableProcessors (Runtime/getRuntime)))))}

         docs
         {:doc "regenerate docs/api.md from the source docstrings"
          :task (shell "python3" "docs/gen_api.py")}

         lib
         {:doc "build libjolt_upbge.{dylib,so} via jolt build --library"
          :task (do (shell "jolt" "build" "--library" "-m" "upbge-jolt.library" "-o" "libjolt_upbge")
                    (println "built: libjolt_upbge.dylib"))}}}
