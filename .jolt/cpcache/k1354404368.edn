{:material "2297:{;; upbge-jolt embeds a jolt runtime (REPL + bridge) inside a UPBGE/Blender\n ;; host process. The host side is a small C shim (native/) exposing a flat C\n ;; ABI over RNA and the game engine; this project builds that runtime as a\n ;; --library shared object the host dlopens.\n ;;\n ;; nREPL streaming (out/err per flush) and :collect-safe exports need the\n ;; 0.8.13 floor; the nrepl middleware dep wants >= 0.8.24-era jolt.nrepl/start\n ;; with the :port-file opts.\n :jolt/min-version \"0.8.13\"\n\n :paths [\"src\"]\n\n :deps {jolt-lang/nrepl {:git/url \"https://github.com/jolt-lang/nrepl\"\n                         :git/tag \"v0.4.1\" :git/sha \"51c2572\"}}\n\n ;; native/upbge_shim.c is compiled against the host UPBGE build. The dylib\n ;; ships beside the source, path-qualified so it loads relative to this\n ;; project, not to wherever the host app runs from. Optional: the core\n ;; runtime (queue/marshal/nREPL) is testable without it; the bridge\n ;; namespaces require it.\n :jolt/native [{:name \"upbge\"\n                :darwin [\"native/libupbge_shim.dylib\"]\n                :linux  [\"native/libupbge_shim.so\"]\n                :optional true}]\n\n :aliases {:test {:extra-paths [\"test\"]\n                  :main-opts   [\"-m\" \"upbge-jolt.test-runner\"]}}\n\n :tasks {:requires ([babashka.fs :as fs])\n         :init (def shlib (str \"native/libupbge_shim.\"\n                               (if (re-find #\"^Mac\" (System/getProperty \"os.name\")) \"dylib\" \"so\")))\n\n         native\n         {:doc \"build the mock host shim dylib (for tests; the real shim needs a UPBGE build)\"\n          :task (if (or (not (fs/exists? shlib))\n                        (seq (fs/modified-since shlib [\"native/mock_shim.c\" \"native/upbge_shim.h\" \"deps.edn\"])))\n                  (do (shell \"cc\" \"-O2\" \"-fPIC\" \"-shared\" \"-Inative\"\n                             \"native/mock_shim.c\" \"-o\" shlib)\n                      (println \"built:\" shlib))\n                  (println \"up to date:\" shlib))}\n\n         test {:doc \"unit tests (headless, mock shim)\" :depends [native] :task (shell \"jolt -M:test\")}\n\n         lib\n         {:doc \"build libjolt_upbge.{dylib,so} via jolt build --library\"\n          :task (do (shell \"jolt\" \"build\" \"--library\" \"-m\" \"upbge-jolt.library\" \"-o\" \"libjolt_upbge\")\n                    (println \"built: libjolt_upbge.dylib\"))}}}\n|679:{:aliases {;; Add cross-project aliases here\n           :outdated {;; Note that it is `:deps`, not `:extra-deps`\n                      :deps {com.github.liquidz/antq {:mvn/version \"2.5.1109\"}}\n                      :main-opts [\"-m\" \"antq.core\"]}\n           :mcp\n           {:deps {org.slf4j/slf4j-nop {:mvn/version \"2.0.16\"} ;; Required for stdio server\n                   com.bhauman/clojure-mcp {:git/url \"https://github.com/bhauman/clojure-mcp.git\"\n                                            :git/tag \"v0.1.6-alpha\"\n                                            :git/sha \"4ad62f4\"}}\n            :exec-fn clojure-mcp.main/start-mcp-server\n            :exec-args {:port 7888}}}}\n|[]|[[jolt-lang/nrepl #:git{:url \"https://github.com/jolt-lang/nrepl\", :tag \"v0.4.1\", :sha \"51c2572\"}]]|[]|[]|v0.8.24|/Users/yogthos/.jolt/gitlibs||||/Users/yogthos|", :value {:roots ["/Users/yogthos/.jolt/gitlibs/https___github.com_jolt-lang_nrepl/51c2572ac53cacbf0a837118e78fb1290136c7ef/src" "/Users/yogthos/.m2/repository/cider/orchard/0.44.0/orchard-0.44.0.jar" "/Users/yogthos/.m2/repository/compliment/compliment/0.8.0/compliment-0.8.0.jar" "/Users/yogthos/.m2/repository/org/clojure/spec.alpha/0.5.238/spec.alpha-0.5.238.jar"], :natives [{:name "libc (POSIX sockets)", :process true, :jolt.deps/root "/Users/yogthos/.jolt/gitlibs/https___github.com_jolt-lang_nrepl/51c2572ac53cacbf0a837118e78fb1290136c7ef"}], :allow-dynamic [], :min-versions [[jolt-lang/nrepl "0.8.13"]], :provides [], :prep [], :immutable-roots ["/Users/yogthos/.m2/repository/cider/orchard/0.44.0/orchard-0.44.0.jar" "/Users/yogthos/.m2/repository/compliment/compliment/0.8.0/compliment-0.8.0.jar" "/Users/yogthos/.m2/repository/org/clojure/spec.alpha/0.5.238/spec.alpha-0.5.238.jar"], :libs {jolt-lang/nrepl #:git{:url "https://github.com/jolt-lang/nrepl", :tag "v0.4.1", :sha "51c2572"}, cider/orchard #:mvn{:version "0.44.0"}, compliment/compliment #:mvn{:version "0.8.0"}, org.clojure/spec.alpha #:mvn{:version "0.5.238"}}, :trace nil, :graph nil}}