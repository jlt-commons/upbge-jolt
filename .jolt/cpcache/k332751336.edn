{:material "5110:{;; upbge-jolt embeds a jolt runtime (REPL + bridge) inside a UPBGE/Blender\n ;; host process. The host side is a small C shim (native/) exposing a flat C\n ;; ABI over RNA and the game engine; this project builds that runtime as a\n ;; --library shared object the host dlopens.\n ;;\n ;; nREPL streaming (out/err per flush) and :collect-safe exports need the\n ;; 0.8.13 floor; the nrepl middleware dep wants >= 0.8.24-era jolt.nrepl/start\n ;; with the :port-file opts.\n :jolt/min-version \"0.8.13\"\n\n :paths [\"src\"]\n\n :deps {jolt-lang/nrepl {:git/url \"https://github.com/jolt-lang/nrepl\"\n                         :git/tag \"v0.4.1\" :git/sha \"51c2572\"}}\n\n ;; native/upbge_shim.c is compiled against the host UPBGE build. The dylib\n ;; ships beside the source, path-qualified so it loads relative to this\n ;; project, not to wherever the host app runs from. Optional: the core\n ;; runtime (queue/marshal/nREPL) is testable without it; the bridge\n ;; namespaces require it.\n :jolt/native [{:name \"upbge\"\n                :darwin [\"native/libupbge_shim.dylib\"]\n                :linux  [\"native/libupbge_shim.so\"]\n                :optional true}]\n\n :aliases {:test {:extra-paths [\"test\"]\n                  :main-opts   [\"-m\" \"upbge-jolt.test-runner\"]}}\n\n :tasks {:requires ([babashka.fs :as fs])\n         :init (do (def os-name (System/getProperty \"os.name\"))\n                   (def mac? (some? (re-find #\"^Mac\" os-name)))\n                   (def shlib (str \"native/libupbge_shim.\" (if mac? \"dylib\" \"so\")))\n                   ;; GNUmakefile's OS/CPU names: lib/$(OS)_$(CPU) for the deps\n                   ;; harvest (macos_arm64, linux_x64, ...), build_$(OS_NCASE)\n                   ;; for the build tree (build_darwin, build_linux)\n                   (def upbge-os (cond (re-find #\"^Mac\" os-name) \"macos\"\n                                       (re-find #\"^Linux\" os-name) \"linux\"\n                                       :else \"windows\"))\n                   (def upbge-os-case (cond mac? \"darwin\"\n                                            (re-find #\"^Linux\" os-name) \"linux\"\n                                            :else \"windows\"))\n                   (def upbge-cpu (case (System/getProperty \"os.arch\")\n                                    \"aarch64\" \"arm64\"\n                                    (\"x86_64\" \"amd64\") \"x64\"\n                                    (System/getProperty \"os.arch\")))\n                   (def upbge-src \"native/upbge\")\n                   (def upbge-build (str \"native/build_\" upbge-os-case))\n                   (def blender-bin (str upbge-build \"/bin/\"\n                                         (if mac? \"Blender.app/Contents/MacOS/Blender\"\n                                             \"blender\")))\n                   ;; make deps harvests the prebuilt platform libs into the\n                   ;; clone's lib/$(OS)_$(CPU) (before that the dir holds only\n                   ;; deps.md from the repo), so any harvested lib marks deps done\n                   (def deps-marker (str upbge-src \"/lib/\" upbge-os \"_\" upbge-cpu \"/imath\")))\n\n         native\n         {:doc \"build the mock host shim dylib (for tests; the real shim needs a UPBGE build)\"\n          :task (if (or (not (fs/exists? shlib))\n                        (seq (fs/modified-since shlib [\"native/mock_shim.c\" \"native/upbge_shim.h\" \"deps.edn\"])))\n                  (do (shell \"cc\" \"-O2\" \"-fPIC\" \"-shared\" \"-Inative\"\n                             \"native/mock_shim.c\" \"-o\" shlib)\n                      (println \"built:\" shlib))\n                  (println \"up to date:\" shlib))}\n\n         test {:doc \"unit tests (headless, mock shim)\" :depends [native] :task (shell \"jolt -M:test\")}\n\n         upbge-deps\n         {:doc \"clone UPBGE into native/upbge and build its dependencies (skipped once harvested)\"\n          :task (if (fs/exists? deps-marker)\n                  (println \"upbge-deps: up to date -\" deps-marker)\n                  (do (when-not (fs/exists? upbge-src)\n                        (shell \"git\" \"clone\" \"https://github.com/UPBGE/upbge.git\" upbge-src))\n                      ;; CMake 4.x dropped <3.5 compat; most UPBGE externals\n                      ;; (openal, x265, ...) still declare it. Env var rather\n                      ;; than -D so it reaches the ExternalProject sub-configures.\n                      (shell \"env\" \"CMAKE_POLICY_VERSION_MINIMUM=3.5\"\n                             \"make\" \"-C\" upbge-src \"-j\"\n                             (str (.availableProcessors (Runtime/getRuntime))) \"deps\")))}\n\n         upbge\n         {:doc \"build the full UPBGE/Blender binary (deps first; skipped once built)\"\n          :depends [upbge-deps]\n          :task (if (fs/exists? blender-bin)\n                  (println \"upbge: up to date -\" blender-bin)\n                  (shell \"make\" \"-C\" upbge-src \"-j\"\n                         (str (.availableProcessors (Runtime/getRuntime)))))}\n\n         lib\n         {:doc \"build libjolt_upbge.{dylib,so} via jolt build --library\"\n          :task (do (shell \"jolt\" \"build\" \"--library\" \"-m\" \"upbge-jolt.library\" \"-o\" \"libjolt_upbge\")\n                    (println \"built: libjolt_upbge.dylib\"))}}}\n|679:{:aliases {;; Add cross-project aliases here\n           :outdated {;; Note that it is `:deps`, not `:extra-deps`\n                      :deps {com.github.liquidz/antq {:mvn/version \"2.5.1109\"}}\n                      :main-opts [\"-m\" \"antq.core\"]}\n           :mcp\n           {:deps {org.slf4j/slf4j-nop {:mvn/version \"2.0.16\"} ;; Required for stdio server\n                   com.bhauman/clojure-mcp {:git/url \"https://github.com/bhauman/clojure-mcp.git\"\n                                            :git/tag \"v0.1.6-alpha\"\n                                            :git/sha \"4ad62f4\"}}\n            :exec-fn clojure-mcp.main/start-mcp-server\n            :exec-args {:port 7888}}}}\n|[]|[[jolt-lang/nrepl #:git{:url \"https://github.com/jolt-lang/nrepl\", :tag \"v0.4.1\", :sha \"51c2572\"}]]|[]|[]|v0.8.24|/Users/yogthos/.jolt/gitlibs||||/Users/yogthos|", :value {:roots ["/Users/yogthos/.jolt/gitlibs/https___github.com_jolt-lang_nrepl/51c2572ac53cacbf0a837118e78fb1290136c7ef/src" "/Users/yogthos/.m2/repository/cider/orchard/0.44.0/orchard-0.44.0.jar" "/Users/yogthos/.m2/repository/compliment/compliment/0.8.0/compliment-0.8.0.jar" "/Users/yogthos/.m2/repository/org/clojure/spec.alpha/0.5.238/spec.alpha-0.5.238.jar"], :natives [{:name "libc (POSIX sockets)", :process true, :jolt.deps/root "/Users/yogthos/.jolt/gitlibs/https___github.com_jolt-lang_nrepl/51c2572ac53cacbf0a837118e78fb1290136c7ef"}], :allow-dynamic [], :min-versions [[jolt-lang/nrepl "0.8.13"]], :provides [], :prep [], :immutable-roots ["/Users/yogthos/.m2/repository/cider/orchard/0.44.0/orchard-0.44.0.jar" "/Users/yogthos/.m2/repository/compliment/compliment/0.8.0/compliment-0.8.0.jar" "/Users/yogthos/.m2/repository/org/clojure/spec.alpha/0.5.238/spec.alpha-0.5.238.jar"], :libs {jolt-lang/nrepl #:git{:url "https://github.com/jolt-lang/nrepl", :tag "v0.4.1", :sha "51c2572"}, cider/orchard #:mvn{:version "0.44.0"}, compliment/compliment #:mvn{:version "0.8.0"}, org.clojure/spec.alpha #:mvn{:version "0.5.238"}}, :trace nil, :graph nil}}